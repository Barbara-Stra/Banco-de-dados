-- Operacao real: registra um agendamento de demonstracao.
-- O mesmo id de agendamento pode ser utilizado novamente sem duplicacao.
-- Nao e chamada aqui para evitar erros de resultados pendentes no phpMyAdmin.
-- Teste em consulta SEPARADA: CALL sp_operacao();

DROP PROCEDURE IF EXISTS sp_operacao;

DELIMITER $$

CREATE PROCEDURE sp_operacao()
BEGIN
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;

    INSERT INTO agendamento (
        agendamento_id,
        agendamento_data,
        agendamento_horario,
        clinica_cnpj,
        profissional_cpf,
        paciente_cpf
    ) VALUES (
        900001,
        '2026-09-21',
        '14:00:00',
        '12345678000199',
        '12345678901',
        '11122233344'
    )
    ON DUPLICATE KEY UPDATE
        agendamento_id = agendamento_id;

    COMMIT;
END$$

DELIMITER ;

-- =====================================================================
-- POVOAR_BD.TXT: 1.000.000 DE PRONTUARIOS, SEM CALL
-- =====================================================================
-- Divide em dez INSERTs de 100 mil linhas para reduzir o risco de timeout.
-- Reexecutar nao gera duplicatas na chave primaria, mesmo se parou no meio.
-- Reconhece os IDs de uma execucao anterior se o registro sintetico 1 existe.
-- Nao remova ou altere a descricao sintetica usada como marcador abaixo.

SET @primeiro_id_prontuario = COALESCE(
    (SELECT MIN(prontuario_id)
     FROM prontuario
     WHERE descricao = 'Registro sintetico de teste numero 1. Conteudo ficticio para teste de volume.'),
    (SELECT COALESCE(MAX(prontuario_id), 0) + 1 FROM prontuario)
);

