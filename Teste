        log_usuario,
        log_operacao
    )
    VALUES (
        OLD.paciente_cpf,
        NEW.paciente_cpf,
        OLD.paciente_nome,
        NEW.paciente_nome,
        OLD.paciente_telefone,
        NEW.paciente_telefone,
        NOW(),
        OLD.profissional_cpf,
        NEW.profissional_cpf,
        CURRENT_USER(),
        'UPDATE'
    );
END$$

