-- =====================================================================
-- M8: AUTOMACAO - ev_rotina RECORRENTE E HISTORICO DE EXECUCOES
-- =====================================================================
-- Complementa (NAO substitui) evento_gerar_100000_registros.
-- A tabela de auditoria permite comprovar uma execucao real pelo agendador.
-- O primeiro disparo fica previsto para o horario de criacao do evento.
-- O agendador precisa permanecer habilitado e o servidor em funcionamento.

CREATE TABLE IF NOT EXISTS log_evento_rotina (
    execucao_id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
    executado_em DATETIME NOT NULL,
    observacao VARCHAR(150) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8;

CREATE EVENT IF NOT EXISTS ev_rotina
ON SCHEDULE EVERY 1 MINUTE
STARTS CURRENT_TIMESTAMP
ON COMPLETION PRESERVE
ENABLE
DO
    INSERT INTO log_evento_rotina (executado_em, observacao)
    VALUES (NOW(), 'Rotina automatica executada pelo agendador MySQL');

