-- =====================================================================
-- INDICE DA DESCRICAO: index_db.txt
-- =====================================================================
-- Usar prefixo 191 evita limites antigos de 767 bytes em InnoDB/utf8.
-- A alternativa DO 0 nao retorna resultset quando o indice ja existe.

SET @sql_indice = (
    SELECT IF(COUNT(*) = 0,
        'CREATE INDEX idx_descricao ON prontuario (descricao(191))',
        'DO 0'
    )
    FROM information_schema.STATISTICS
    WHERE TABLE_SCHEMA = DATABASE()
      AND TABLE_NAME = 'prontuario'
      AND INDEX_NAME = 'idx_descricao'
);
PREPARE stmt_indice FROM @sql_indice;
EXECUTE stmt_indice;
DEALLOCATE PREPARE stmt_indice;


-- =====================================================================
-- IMPLEMENTACAO_EVENTS.TXT: 100.000 REGISTROS ADICIONAIS EM 5 MINUTOS
-- =====================================================================
-- EVENT e procedure sao instalados agora; CALL e executado pelo agendador,
-- nao pelo phpMyAdmin. Repeticoes sao protegidas por INSERT IGNORE.
-- Exige permissao de administrador para SET GLOBAL e permissao EVENT.
SET time_zone = '-03:00';
SET GLOBAL event_scheduler = ON;

-- Evento original preservado na segunda execucao (nao reinicia os 5 minutos).
DROP PROCEDURE IF EXISTS sp_gerar_100000_registros;

DELIMITER $$

CREATE PROCEDURE sp_gerar_100000_registros()
BEGIN
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        DROP TEMPORARY TABLE IF EXISTS tmp_numeros_geracao;
        RESIGNAL;
    END;

    DROP TEMPORARY TABLE IF EXISTS tmp_numeros_geracao;

    CREATE TEMPORARY TABLE tmp_numeros_geracao (
        n INT NOT NULL PRIMARY KEY
    ) ENGINE=InnoDB;

    INSERT INTO tmp_numeros_geracao (n)
    SELECT
        1 + a.n + b.n * 10 + c.n * 100
          + d.n * 1000 + e.n * 10000
    FROM
        (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2
         UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL
         SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7
         UNION ALL SELECT 8 UNION ALL SELECT 9) a
    CROSS JOIN
        (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2
         UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL
         SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7
         UNION ALL SELECT 8 UNION ALL SELECT 9) b
    CROSS JOIN
        (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2
         UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL
         SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7
         UNION ALL SELECT 8 UNION ALL SELECT 9) c
    CROSS JOIN
        (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2
         UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL
         SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7
         UNION ALL SELECT 8 UNION ALL SELECT 9) d
    CROSS JOIN
        (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2
         UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL
         SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7
         UNION ALL SELECT 8 UNION ALL SELECT 9) e;

    START TRANSACTION;

    INSERT IGNORE INTO clinica (
        clinica_cnpj,
        clinica_nome,
        clinica_rua,
        clinica_bairro,
        clinica_complemento,
        clinica_numero,
        clinica_media_custo
    )
    SELECT
        CAST(80000000000000 + n AS CHAR),
        CONCAT('Clinica Teste ', LPAD(n, 4, '0')),
        CONCAT('Rua de Teste ', n),
        'Bairro de Teste',
        NULL,
        CAST(n AS CHAR),
        100.00 + MOD(n, 150)
    FROM tmp_numeros_geracao
    WHERE n <= 1000;

    INSERT IGNORE INTO profissional (
        profissional_cpf,
        profissional_nome,
        profissional_telefone,
        profissional_email,
        profissional_valor_consulta
    )
    SELECT
        CAST(80000000000 + n AS CHAR),
        CONCAT('Profissional Teste ', LPAD(n, 5, '0')),
        CONCAT('+55 11 7', LPAD(n, 8, '0')),
        CONCAT(
            'profissional.teste',
            LPAD(n, 5, '0'),
            '@exemplo.invalid'
        ),
        150.00 + MOD(n, 151)
    FROM tmp_numeros_geracao
    WHERE n <= 10000;

    INSERT IGNORE INTO paciente (
        paciente_cpf,
        paciente_nome,
        paciente_telefone,
        paciente_endereco,
        profissional_cpf
    )
    SELECT
        CAST(60000000000 + n AS CHAR),
        CONCAT('Paciente Teste ', LPAD(n, 5, '0')),
        CONCAT('+55 11 8', LPAD(n, 8, '0')),
        CONCAT('Endereco de teste ', n, ', Bairro de Teste'),
        CAST(
            80000000000 + MOD(n - 1, 10000) + 1
            AS CHAR
        )
    FROM tmp_numeros_geracao
    WHERE n <= 80000;

    INSERT IGNORE INTO equipe (
        clinica_cnpj,
        profissional_cpf
    )
    SELECT
        CAST(
            80000000000000 + MOD(n - 1, 1000) + 1
            AS CHAR
        ),
        CAST(80000000000 + n AS CHAR)
    FROM tmp_numeros_geracao
    WHERE n <= 9000;

    COMMIT;

    DROP TEMPORARY TABLE IF EXISTS tmp_numeros_geracao;
END$$

CREATE EVENT IF NOT EXISTS evento_gerar_100000_registros
ON SCHEDULE AT CURRENT_TIMESTAMP + INTERVAL 5 MINUTE
ON COMPLETION PRESERVE
ENABLE
DO
    CALL sp_gerar_100000_registros()$$

DELIMITER ;



